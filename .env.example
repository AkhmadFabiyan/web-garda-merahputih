# Salin jadi .env.local lalu isi nilainya:
#   Copy-Item .env.example .env.local
# Jangan commit .env.local (sudah di .gitignore).

# Upstash Redis: urutan FAQ/kontak terpopuler dan pencatatan klik.
# Upstash Console -> database -> REST API: salin UPSTASH_REDIS_REST_URL dan UPSTASH_REDIS_REST_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chatbot Gara (AI). Buat di https://aistudio.google.com/apikey
# Cek setelah diisi: node scripts/check-ai-keys.mjs .env.local
GEMINI_API_KEY=
